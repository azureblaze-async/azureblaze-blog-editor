# Supabase project -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side upload authorization (same project/public key as above; NOT service_role)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudflare R2 -> Manage R2 API Tokens -> Object Read & Write, restricted to your bucket
# Server-only: NEVER prefix these with VITE_ and NEVER commit real values.
R2_ACCOUNT_ID=your-32-character-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-s3-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-s3-secret-access-key
R2_BUCKET_NAME=azureblaze-media
# Bucket Settings -> Custom Domains (recommended) or enabled Public Development URL
R2_PUBLIC_BASE_URL=https://images.example.com
